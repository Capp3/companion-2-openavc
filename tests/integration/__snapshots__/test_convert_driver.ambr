# name: test_convert_dummy_writes_valid_avcdriver_golden
  '''
  id: dummy_device
  name: Dummy Device
  manufacturer: Generic
  category: utility
  version: 1.0.0
  author: C2O Fixture Bot
  transport: tcp
  description: Purpose-built C2O test module covering every extractor surface
  verified: false
  simulated: true
  ports:
  - 5000
  tags:
  - tcp
  source_url: https://github.com/Capp3/companion-2-openavc
  delimiter: "\n"
  help:
    overview: Connect to the dummy device on the configured host and port.
    setup: "## Setup\n\nEnter the device IP address and TCP port, then enable polling if needed."
  discovery:
    port_open:
    - 5000
    manufacturer_alias:
    - generic
  default_config:
    host: 192.168.1.10
    port: 5000
    poll_interval: 5
    verbose: false
    mode: auto
  config_schema:
    host:
      type: string
      label: Host
    port:
      type: integer
      label: Port
      min: 1
      max: 65535
    poll_interval:
      type: integer
      label: Poll interval (sec)
      min: 1
      max: 60
    verbose:
      type: boolean
      label: Verbose logging
    mode:
      type: enum
      label: Mode
      values:
      - auto
      - manual
  state_variables:
    device_label:
      label: Device Label
      type: string
    input_level:
      label: Input Level
      type: integer
    mute_state:
      label: Mute State
      type: boolean
  commands:
    set_input:
      label: Set Input
      params:
        input:
          type: integer
          label: Input
          min: 1
          max: 8
      send: "SET INPUT {input}\n"
    stream_start:
      label: Stream
      params: {}
      send: "STREAM START\n"
    stream_stop:
      label: Stream
      params: {}
      send: "STREAM STOP\n"
    configure:
      label: Configure
      params:
        mode:
          type: enum
          label: Mode
          values:
          - auto
          - manual
        label:
          type: string
          label: Label
      send: "CFG {mode} {label}\n"
  responses:
  - match: ^INPUT=(\d+)$
    mappings:
    - group: 1
      state: input_level
      type: integer
  - match: ^MUTE=(ON|OFF)$
    mappings:
    - group: 1
      state: mute_state
      map:
        'ON': true
        'OFF': false
  - match: ^LABEL=(.+)$
    set:
      device_label: $1
  polling:
    queries:
    - "QUERY INPUT\n"
    - "QUERY MUTE\n"
  compatible_models:
  - manufacturer: Generic
    models:
    - Dummy Model A
    confidence: untested
  simulator:
    initial_state:
      device_label: ''
      input_level: 0
      mute_state: false
    controls:
    - type: indicator
      key: device_label
      label: Device Label
    - type: indicator
      key: input_level
      label: Input Level
    - type: toggle
      key: mute_state
      label: Mute State
    command_handlers:
    - match: SET INPUT (\d+)
      respond: "SET INPUT {1}\n"
    - receive: STREAM START
      respond: "STREAM START\n"
    - receive: STREAM STOP
      respond: "STREAM STOP\n"
    - match: CFG (\S+) (\S+)
      respond: "CFG {1} {2}\n"
  
  '''
# ---
