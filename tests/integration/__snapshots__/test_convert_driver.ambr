# serializer version: 1
# name: test_convert_bmd_writes_valid_avcdriver_golden
  '''
  id: bmd_webpresenter
  name: WebPresenter
  manufacturer: Blackmagic Design
  category: streaming
  version: 2.1.3
  author: Peter Daniel
  transport: tcp
  description: Live stream from any SDI video source direct to YouTube, Facebook, Twitter and more
  source_url: https://github.com/bitfocus/companion-module-bmd-webpresenter
  delimiter: "\n"
  help:
    overview: Module to control and monitor the [Blackmagic Design Web Presenter HD and 4K](https://www.blackmagicdesign.com/products/blackmagicwebpresenter).
      This module does not support the discontinued USB only **Web Presenter** product.
    setup: "Once connection to the device has been established the stream 'Video Mode', 'Platform' and 'Quality'\
      \ action parameters will be populated with the options that the device supports. If no device connection\
      \ is possible then these parameters will be unavailable. The 'Server' and 'Stream Key' will not be\
      \ pre-populated. Use the Blackmagic WebPresenter desktop app to discover the valid 'Server' options\
      \ for your platform. Consult your streaming platform service provider for the 'Stream Key'.\n\nPlease\
      \ log issues and feature requests on [github](https://github.com/bitfocus/companion-module-bmd-webpresenter)."
  discovery:
    port_open:
    - 9977
    manufacturer_alias:
    - Blackmagic Design
    - Blackmagic
  default_config:
    host: ''
    port: 9977
    poll_interval: 1
  config_schema:
    host:
      type: string
      label: Device IP
      required: true
    port:
      type: integer
      label: Device Port
      min: 1
      max: 65535
  state_variables:
    model:
      label: Device Model
      type: string
    label:
      label: Device Label
      type: string
    software:
      label: Device Software
      type: string
    video_mode:
      label: Video Mode
      type: string
    platform:
      label: Platform
      type: string
    server:
      label: Server
      type: string
    key:
      label: Stream Key
      type: string
    quality:
      label: Stream Quality
      type: string
    stream_state:
      label: Streaming State
      type: string
    stream_duration:
      label: Streaming Duration
      type: string
    stream_duration_HH:
      label: Streaming Duration (Hours)
      type: string
    stream_duration_MM:
      label: Streaming Duration (Minutes)
      type: string
    stream_duration_SS:
      label: Streaming Duration (Seconds)
      type: string
    stream_bitrate:
      label: Stream Bitrate
      type: string
    cache:
      label: Cache Used
      type: string
    passphrase:
      label: Passphrase
      type: string
    URL:
      label: Current URL
      type: string
  commands:
    stream_start:
      label: Streaming Control
      params: {}
      send: "STREAM STATE:\nAction: Start\n\n"
    stream_stop:
      label: Streaming Control
      params: {}
      send: "STREAM STATE:\nAction: Stop\n\n"
  responses:
  - match: ^Label:\s*(.+)$
    set:
      label: $1
  - match: ^Model:\s*(.+)$
    set:
      model: $1
  - match: ^Software\ Release:\s*(.+)$
    set:
      software: $1
  - match: ^Video\ Mode:\s*(.+)$
    set:
      video_mode: $1
  - match: ^Current\ Quality\ Level:\s*(.+)$
    set:
      quality: $1
  - match: ^Current\ Server:\s*(.+)$
    set:
      server: $1
  - match: ^Current\ Platform:\s*(.+)$
    set:
      platform: $1
  - match: ^Stream\ Key:\s*(.+)$
    set:
      key: $1
  - match: ^Password:\s*(.+)$
    set:
      passphrase: $1
  - match: ^Current\ URL:\s*(.+)$
    set:
      URL: $1
  - match: ^Status:\s*(.+)$
    set:
      stream_state: $1
  - match: ^Duration:\s*(.+)$
    set:
      stream_duration: $1
  - match: ^Bitrate:\s*(.+)$
    set:
      stream_bitrate: $1
  - match: ^Cache\ Used:\s*(.+)$
    set:
      cache: $1
  polling:
    queries:
    - "STREAM STATE:\n\n"
  compatible_models:
  - manufacturer: Blackmagic Design
    models:
    - WebPresenter HD
    - WebPresenter 4K
    confidence: untested
  simulator:
    initial_state:
      model: ''
      label: ''
      software: ''
      video_mode: ''
      platform: ''
      server: ''
      key: ''
      quality: ''
      stream_state: ''
      stream_duration: ''
      stream_duration_HH: ''
      stream_duration_MM: ''
      stream_duration_SS: ''
      stream_bitrate: ''
      cache: ''
      passphrase: ''
      URL: ''
    controls:
    - type: indicator
      key: model
      label: Device Model
    - type: indicator
      key: label
      label: Device Label
    - type: indicator
      key: software
      label: Device Software
    - type: indicator
      key: video_mode
      label: Video Mode
    - type: indicator
      key: platform
      label: Platform
    - type: indicator
      key: server
      label: Server
    - type: indicator
      key: key
      label: Stream Key
    - type: indicator
      key: quality
      label: Stream Quality
    - type: indicator
      key: stream_state
      label: Streaming State
    - type: indicator
      key: stream_duration
      label: Streaming Duration
    - type: indicator
      key: stream_duration_HH
      label: Streaming Duration (Hours)
    - type: indicator
      key: stream_duration_MM
      label: Streaming Duration (Minutes)
    - type: indicator
      key: stream_duration_SS
      label: Streaming Duration (Seconds)
    - type: indicator
      key: stream_bitrate
      label: Stream Bitrate
    - type: indicator
      key: cache
      label: Cache Used
    - type: indicator
      key: passphrase
      label: Passphrase
    - type: indicator
      key: URL
      label: Current URL
  
  '''
# ---
# name: test_convert_dummy_writes_valid_avcdriver_golden
  '''
  id: dummy_device
  name: Dummy Device
  manufacturer: Generic
  category: utility
  version: 1.0.0
  author: C2O Fixture Bot
  transport: tcp
  description: Purpose-built C2O test module covering every extractor surface
  source_url: https://github.com/Capp3/companion-2-openavc
  delimiter: "\n"
  help:
    overview: Connect to the dummy device on the configured host and port.
    setup: "## Setup\n\nEnter the device IP address and TCP port, then enable polling if needed."
  discovery:
    port_open:
    - 5000
    manufacturer_alias:
    - Generic
  default_config:
    host: 192.168.1.10
    port: 5000
    poll_interval: 5
    verbose: false
    mode: auto
  config_schema:
    host:
      type: string
      label: Host
    port:
      type: integer
      label: Port
      min: 1
      max: 65535
    poll_interval:
      type: integer
      label: Poll interval (sec)
      min: 1
      max: 60
    verbose:
      type: boolean
      label: Verbose logging
    mode:
      type: enum
      label: Mode
      values:
      - auto
      - manual
  state_variables:
    device_label:
      label: Device Label
      type: string
    input_level:
      label: Input Level
      type: integer
    mute_state:
      label: Mute State
      type: boolean
  commands:
    set_input:
      label: Set Input
      params:
        input:
          type: integer
          label: Input
          min: 1
          max: 8
      send: "SET INPUT {input}\n"
    stream_start:
      label: Stream
      params: {}
      send: "STREAM START\n"
    stream_stop:
      label: Stream
      params: {}
      send: "STREAM STOP\n"
    configure:
      label: Configure
      params:
        mode:
          type: enum
          label: Mode
          values:
          - auto
          - manual
        label:
          type: string
          label: Label
      send: "CFG {mode} {label}\n"
  responses:
  - match: ^INPUT=(\d+)$
    mappings:
    - group: 1
      state: input_level
      type: integer
  - match: ^MUTE=(ON|OFF)$
    mappings:
    - group: 1
      state: mute_state
      map:
        'ON': true
        'OFF': false
  - match: ^LABEL=(.+)$
    set:
      device_label: $1
  polling:
    queries:
    - "QUERY INPUT\n"
    - "QUERY MUTE\n"
  compatible_models:
  - manufacturer: Generic
    models:
    - Dummy Model A
    confidence: untested
  simulator:
    initial_state:
      device_label: ''
      input_level: 0
      mute_state: false
    controls:
    - type: indicator
      key: device_label
      label: Device Label
    - type: indicator
      key: input_level
      label: Input Level
    - type: toggle
      key: mute_state
      label: Mute State
    command_handlers:
    - match: SET INPUT (\d+)
      respond: "SET INPUT {1}\n"
    - receive: STREAM START
      respond: "STREAM START\n"
    - receive: STREAM STOP
      respond: "STREAM STOP\n"
    - match: CFG (\S+) (\S+)
      respond: "CFG {1} {2}\n"
  
  '''
# ---
